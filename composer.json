{
  "name": "digitalcz/openid-connect",
  "description": "PHP implementation of OpenID Connect using symfony/contracts",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "openid",
    "openid connect",
    "oidc",
    "php",
    "symfony"
  ],
  "authors": [
    {
      "name": "Digital Solutions s.r.o.",
      "email": "devs@digital.cz",
      "homepage": "https://digital.cz",
      "role": "Developer"
    },
    {
      "name": "Pavel Stejskal",
      "email": "spajxo@gmail.com",
      "homepage": "https://github.com/spajxo",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/digitalcz/openid-connect",
  "require": {
    "php": "^8.4",
    "symfony/cache-contracts": "^3.6",
    "symfony/http-client-contracts": "^3.6",
    "web-token/jwt-library": "^4.0"
  },
  "require-dev": {
    "digitalcz/coding-standard": "^0.4.0",
    "ergebnis/composer-normalize": "^2.47",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.2",
    "symfony/cache": "^7.3",
    "symfony/http-client": "^7.3",
    "symfony/var-dumper": "^7.3 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "DigitalCz\\OpenIDConnect\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DigitalCz\\OpenIDConnect\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "checks": [
      "@cs",
      "@phpstan",
      "@tests"
    ],
    "cs": "phpcs -p",
    "csfix": "phpcbf -p",
    "phpstan": "phpstan analyse",
    "tests": "phpunit"
  }
}
